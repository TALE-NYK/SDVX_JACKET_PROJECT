<%# キャラクター一覧の表示 %>
<p style="color: green"><%= notice %></p>

<h1>Characters</h1>

<div id="characters">
  <% @characters.each do |character| %>
    <%= render character %>
    <p>
      <%= link_to "#{character}", character %>
    </p>
  <% end %>
</div>

<% if false %>
  # この画面からキャラクター新規登録できるとよくないし、必要がない
  <%= link_to "New character", new_character_path %>
<% end %>